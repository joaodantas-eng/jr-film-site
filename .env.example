# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo — ele é versionado no Git.
# Variáveis SEM o prefixo NEXT_PUBLIC_ ficam só no servidor.

# --- Site ---
# Domínio oficial, sem barra no final. Usado em canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://jrfilm.vercel.app

# --- Assistente (Google Gemini) — somente servidor ---
GEMINI_API_KEY=
# Opcional: modelo, teto de tokens de resposta e tempo limite (ms)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=25000

# Interruptores de emergência (true/false). Exigem novo deploy para valer.
ASSISTANT_ENABLED=true
ASSISTANT_IMAGES_ENABLED=true

# Limites de uso (por visitante, identificado por hash do IP) e teto global diário
ASSISTANT_LIMIT_PER_MINUTE=5
ASSISTANT_LIMIT_PER_HOUR=30
ASSISTANT_LIMIT_PER_DAY=60
ASSISTANT_GLOBAL_LIMIT_PER_DAY=800
ASSISTANT_MAX_CONCURRENT=8

# Rate limit distribuído — OBRIGATÓRIO em produção. Sem estas variáveis, o
# assistente fica indisponível em produção (o site continua no ar). Crie um
# banco Redis no Upstash (upstash.com, plano gratuito) e copie a REST URL e o token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Só para testes: permite contar os limites na memória de cada instância (NÃO recomendado).
ASSISTANT_ALLOW_MEMORY_RATE_LIMIT=false
# Opcional: texto aleatório usado no hash do IP
RATE_LIMIT_SALT=

# --- CAPTCHA do assistente (Cloudflare Turnstile, gratuito) ---
# dash.cloudflare.com → Turnstile → Add widget (domínio jrfilm.vercel.app, modo "Managed").
# Sem as duas chaves, o CAPTCHA fica desligado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Avaliações do Google (Places API) — somente servidor ---
GOOGLE_PLACES_API_KEY=

# --- Google Analytics 4 (ID público, ex: G-XXXXXXXXXX). Vazio = desativado ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
